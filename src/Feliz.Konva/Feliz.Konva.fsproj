<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <None Include="override.css">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <Compile Include="Types.fs" />
    <Compile Include="Interop.fs" />
    <Compile Include="Options.fs" />
    <Compile Include="Rect.fs" />
    <Compile Include="Circle.fs" />
    <Compile Include="Text.fs" />
    <Compile Include="Image.fs" />
    <Compile Include="Path.fs" />
    <Compile Include="Layer.fs" />
    <Compile Include="Stage.fs" />
    <Compile Include="Konva.fs" />
  </ItemGroup>
  <PropertyGroup>
    <NpmDependencies>
      <NpmPackage Name="react-konva" Version="gt 2.0.0 lt 2.9.9" ResolutionStrategy="Max" DevDependency="true" />
    </NpmDependencies>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="*.fsproj; *.fs; *.js; *.css" Exclude="**\*.fs.js" PackagePath="fable\" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
